---
layout: layouts/base.njk
title: Design Directions — Pick a Look for Your Website
description: Twenty complete design directions — colour palette and type pairing together — so you can point at the look you want for your new website instead of hunting for sites you like.
pageCss: design-directions
permalink: /design-directions/
---
{#
  Design Directions — the picker linked from the Website Build Brief.

  FORMAT PROOF: 4 of a planned 20.

  Rules this page obeys:
  - Each card is a COMPLETE direction (palette + type pairing), never a parts bin.
    The whole point is removing homework, and asking a client to combine palette 7
    with font 12 is homework.
  - Sample copy is IDENTICAL in every card on purpose. Holding the words constant is
    what lets someone actually see the design differ.
  - No real business name appears in any preview — the wordmark is the direction's own
    name. (Standing rule: no client data as demo data, RFC 2606 or nothing.)
  - Every palette is contrast-gated by scripts/check-directions.mjs. Do not hand-edit a
    hex in directions.json without re-running it (and --selftest).
#}
{# Self-hosted, subset webfaces. GENERATED by scripts/selfhost-fonts.py from
   directions.json; verified by scripts/check-directions.mjs. No third-party font
   host - we ding other people's sites for those in /site-audit. #}
<link rel="stylesheet" href="/css/directions-fonts.css?v={{ buildStamp }}" />

<div class="header-band">
  <span class="header-eyebrow">Website design</span>
  <h1>Pick a direction</h1>
</div>

<div class="wrap">
  <div class="dd-intro">
    <p>
      Most design conversations start with &ldquo;go find three websites you like.&rdquo; That is homework, and
      it usually produces three sites from three different industries that cannot be reconciled.
    </p>
    <p>
      So here is the shortcut. Each card below is a <strong>complete direction</strong> — colours and
      typefaces chosen to work together, not a menu of parts to assemble. The words are deliberately the
      same in every preview so the only thing changing is the design.
    </p>
    <p>
      Pick one or two, hit <strong>Copy my picks</strong>, and paste the codes into your build brief.
      Nothing here is binding — it tells me which direction to run at, and we refine from there.
    </p>
    <p class="dd-note">
      Already been sent a <a href="/build-brief/">build brief</a>? The picker is built into step 2 of it,
      so you can choose there instead — this page is just the bigger, slower look.
    </p>
  </div>

  <div class="dd-pickbar">
    <span class="dd-pickbar__label">Your picks:</span>
    <span class="dd-pickbar__list" id="ddPicks"></span>
    <button type="button" class="dd-copy" id="ddCopy" disabled>Copy my picks</button>
  </div>

  <div class="dd-grid">
    {% for d in directions.items %}
    <article class="dd-card" data-code="{{ d.code }}" data-name="{{ d.name }}"
      style="--d-page:{{ d.palette.page }};--d-surface:{{ d.palette.surface }};--d-ink:{{ d.palette.ink }};--d-muted:{{ d.palette.muted }};--d-accent:{{ d.palette.accent }};--d-accent-ink:{{ d.palette.accentInk }};--d-hair:{{ d.palette.hair }};--d-btn:{{ d.palette.btnLabel }};--d-fh:{{ d.type.heading.stack | safe }};--d-fb:{{ d.type.body.stack | safe }};--d-fwh:{{ d.type.heading.weight }}">

      <div class="dd-card__head">
        <span class="dd-code">{{ d.code }}</span>
        <h2 class="dd-card__name">{{ d.name }}</h2>
      </div>
      <p class="dd-card__blurb">{{ d.blurb }}</p>

      {# ---- the miniature site, rendered in this direction's own tokens ---- #}
      <div class="dd-preview" role="img" aria-label="Preview of the {{ d.name }} direction: {{ d.typeClass }} type on a {{ d.ground }} background.">
        {# Sample copy comes from directions.json, NOT from here: the webfont `text=`
           subset is generated from those same strings, so hardcoding copy in this
           template would silently render glyphs the subset does not carry. #}
        <div class="dd-nav">
          <span class="dd-nav__mark">{{ d.name }}</span>
          <span class="dd-nav__links">{% for n in directions.sample.nav %}<span>{{ n }}</span>{% endfor %}</span>
          <span class="dd-nav__cta">{{ directions.sample.navCta }}</span>
        </div>
        <p class="dd-hero__eyebrow">{{ directions.sample.eyebrow }}</p>
        <p class="dd-hero__h">{{ directions.sample.headline }}</p>
        <p class="dd-hero__p">{{ directions.sample.body }}</p>
        <div class="dd-hero__row">
          <span class="dd-btn">{{ directions.sample.ctaPrimary }}</span>
          <span class="dd-link">{{ directions.sample.ctaSecondary }}</span>
        </div>
        <div class="dd-cards">
          {% for t in directions.sample.tiles %}
          <div class="dd-tile"><p class="dd-tile__h">{{ t.h }}</p><p class="dd-tile__p">{{ t.p }}</p></div>
          {% endfor %}
        </div>
      </div>

      {# ---- what it is made of ---- #}
      <div class="dd-spec">
        <div class="dd-swatches">
          {% set roles = [["Page", d.palette.page], ["Surface", d.palette.surface], ["Text", d.palette.ink], ["Accent", d.palette.accent], ["Accent type", d.palette.accentInk]] %}
          {% for r in roles %}
          <div class="dd-swatch">
            <div class="dd-swatch__chip" style="background:{{ r[1] }}"></div>
            <span class="dd-swatch__role">{{ r[0] }}</span>
            <span class="dd-swatch__hex">{{ r[1] }}</span>
          </div>
          {% endfor %}
        </div>
        <p class="dd-meta">
          <strong>{{ d.type.heading.name }}</strong> for headlines, <strong>{{ d.type.body.name }}</strong> for text.<br />
          Suits: {{ d.suits }}
        </p>
        <div class="dd-moods">
          {% for m in d.mood %}<span class="dd-mood">{{ m }}</span>{% endfor %}
        </div>
        <button type="button" class="dd-pick">Pick {{ d.code }}</button>
      </div>
    </article>
    {% endfor %}
  </div>

  <p class="dd-intro" style="margin-top:2.5rem">
    None of these quite right? Say so — these are a starting point, not the whole universe. Tell me which
    one is closest and what is wrong with it, and that is usually a faster route than starting from blank.
  </p>
</div>

<script>
(function () {
  var picked = [];
  var list = document.getElementById("ddPicks");
  var copy = document.getElementById("ddCopy");

  function render() {
    list.textContent = picked.map(function (p) { return p.code + " " + p.name; }).join("  ·  ");
    copy.disabled = picked.length === 0;
    copy.textContent = "Copy my picks";
  }

  document.querySelectorAll(".dd-card").forEach(function (card) {
    card.querySelector(".dd-pick").addEventListener("click", function () {
      var code = card.dataset.code, name = card.dataset.name;
      var at = picked.findIndex(function (p) { return p.code === code; });
      if (at > -1) { picked.splice(at, 1); card.classList.remove("is-picked"); this.textContent = "Pick " + code; }
      else { picked.push({ code: code, name: name }); card.classList.add("is-picked"); this.textContent = "Picked ✓"; }
      render();
    });
  });

  copy.addEventListener("click", function () {
    var text = "Design direction: " + picked.map(function (p) { return p.code + " (" + p.name + ")"; }).join(", ");
    function done() { copy.textContent = "Copied ✓"; setTimeout(render, 2000); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, fallback);
    } else { fallback(); }
    function fallback() {
      var ta = document.createElement("textarea");
      ta.value = text; ta.setAttribute("readonly", "");
      ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); done(); } catch (e) { copy.textContent = "Press Ctrl+C"; ta.style.opacity = "1"; return; }
      document.body.removeChild(ta);
    }
  });

  render();
})();
</script>
