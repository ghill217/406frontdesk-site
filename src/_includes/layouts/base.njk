<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# ---- SEO ---- #}
  <title>{{ title }}{% if title %} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}

  {# ---- Open Graph / social ---- #}
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ ogTitle or title or site.name }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle or title or site.name }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />

  {# ---- Icons — Identity v2 (Many Glacier contour), 2026-08-30 ----
     NEW FILENAMES on purpose. netlify.toml serves /assets/* as
     `immutable, max-age=31536000`, so overwriting an asset in place would leave
     returning visitors on the OLD logo for up to a year.
     Sizes follow the three-mark rule: <=48px uses the MICRO mark (no numerals —
     three serif digits cannot survive a 16px badge); 192 and the touch icon use
     SOLID. The contour mark is never used at icon sizes. #}
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32-v2.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/img/favicon-48-v2.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon-192-v2.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon-v2.png" />

  {# ---- Fonts: self-hosted, no third-party request. Preload the two latin files
       every page actually paints with; the latin-ext + italic cuts load on demand. #}
  <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/dm-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/fonts.css?v={{ buildStamp }}" />

  {# ---- Design tokens: must load BEFORE page styles ---- #}
  <link rel="stylesheet" href="/css/tokens.css?v={{ buildStamp }}" />

  {# ---- Page styles ---- #}
  {% if pageCss %}<link rel="stylesheet" href="/css/{{ pageCss }}.css?v={{ buildStamp }}" />{% endif %}
  <link rel="stylesheet" href="/css/a11y.css?v={{ buildStamp }}" />

  {# ---- Structured data: LocalBusiness ---- #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "406 Front Desk",
    "legalName": "406 Front Desk LLC",
    "url": "https://406frontdesk.com",
    "telephone": "+14068400404",
    "email": "admin@406frontdesk.com",
    "areaServed": ["Flathead Valley, Montana", "Montana", "United States"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kalispell",
      "addressRegion": "MT",
      "addressCountry": "US"
    },
    "description": "AI receptionist for local service businesses — answers calls, texts, and chats 24/7, books appointments, and follows up automatically. Also builds fast small-business websites and does local SEO and Google Business Profile optimization for Kalispell and Flathead Valley businesses.",
    "knowsAbout": ["AI receptionist", "answering service", "missed-call text-back", "appointment booking", "web design", "local SEO", "Google Business Profile optimization"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "406 Front Desk services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Receptionist", "serviceType": "Telephone answering service", "url": "https://406frontdesk.com/features/", "areaServed": "Montana" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Website Design & Build", "serviceType": "Web design", "url": "https://406frontdesk.com/websites/", "areaServed": "Montana" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO & Website Tune-up", "serviceType": "Search engine optimization", "url": "https://406frontdesk.com/seo/", "areaServed": "Montana" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Business Profile Optimization", "serviceType": "Local search marketing", "url": "https://406frontdesk.com/seo/", "areaServed": "Montana" } }
      ]
    },
    "priceRange": "$$",
    "slogan": "Always Answering",
    "sameAs": ["https://www.instagram.com/406_frontdesk/"],
    "founder": { "@type": "Person", "name": "Gus Hill" },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  }
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

{# GHL chat widget — site-wide, loaded async so it never blocks first paint #}
<script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="{{ site.chatWidgetId }}" async></script>
{# Call CTA, bottom-left (chat widget owns bottom-right) — a real phone call demos the AI receptionist
   with every capability incl. transfers, which GHL web-call widgets don't support #}
<a href="tel:{{ site.phone }}" class="call-cta" aria-label="Call the AI receptionist live at {{ site.phoneDisplay }}">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
  <span class="call-cta__label">Hear it live — {{ site.phoneDisplay }}</span>
</a>
<style>
/* Icon-only by default so this fixed button never covers left-aligned section
   headlines — it used to sit on top of "Let it run forever" at 1440x1000.
   Hover/focus reveals the number on desktop; on touch a tap just dials. */
.call-cta{position:fixed;bottom:20px;left:20px;z-index:9990;display:inline-flex;align-items:center;gap:0;padding:.85rem;border-radius:var(--radius-pill,999px);background:var(--accent,#E8A435);color:var(--navy,#0F2540);font-weight:600;font-size:var(--fs-base,16px);line-height:1;text-decoration:none;box-shadow:0 4px 14px rgba(15,37,64,.35);transition:transform .15s ease,box-shadow .15s ease,padding .2s ease,gap .2s ease}
.call-cta:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(15,37,64,.45)}
.call-cta svg{flex:none}
.call-cta__label{max-width:0;opacity:0;overflow:hidden;white-space:nowrap;transition:max-width .2s ease,opacity .15s ease}
.call-cta:hover,.call-cta:focus-visible{padding:.8rem 1.15rem;gap:.5rem}
.call-cta:hover .call-cta__label,.call-cta:focus-visible .call-cta__label{max-width:22ch;opacity:1}
@media (prefers-reduced-motion:reduce){.call-cta,.call-cta__label{transition:none}}

/* ── Mobile action bar ──────────────────────────────────────────────────────
   Below 760px the nav CTA is display:none, so on the longest version of the
   page (the homepage is ~16 screens at 390px) there was NO persistent demo CTA
   at all. This is that CTA. It carries the call action too, so it REPLACES the
   floating .call-cta rather than becoming a third floating object on a 390px
   screen. Desktop is unaffected — there the nav CTA does this job.
   ⚠️ padding-right leaves room for the GHL chat bubble, which owns the
   bottom-right corner and whose position we do not control. */
.fd406-actionbar{
  position:fixed;left:0;right:0;bottom:0;z-index:9990;display:none;
  align-items:center;gap:10px;
  /* padding-right clears the GHL chat bubble, which owns the bottom-right
     corner and whose position we do not control. Measured at 390px: the bubble
     occupies x 312-370, so at the old 76px the call button ended at x=314 and
     overlapped it by 2px. 90px puts the call button's right edge at 300 — a
     12px gap. The demo button is flex:1, so it absorbs the change and gets
     narrower on its own; no separate width rule needed. */
  padding:10px 90px 10px 12px;
  background:rgba(15,37,64,.97);
  border-top:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  transform:translateY(110%);transition:transform .28s ease;
}
body.fd406-past-hero .fd406-actionbar{transform:translateY(0)}
.fd406-actionbar__demo{
  flex:1;text-align:center;background:var(--accent,#E8A435);color:var(--navy,#0F2540);
  /* Trimmed a touch (was 15px / 13px 16px) so the bar reads lighter now that
     it is narrower. Height lands ~38px — well clear of WCAG 2.5.8's 24px
     minimum target, and it stays the widest thing in the bar. */
  font-weight:600;font-size:14.5px;line-height:1;padding:12px 14px;border-radius:8px;text-decoration:none;
  transition:background .2s ease;
}
/* Same amber ramp as every other filled button: lighter on hover, darker on
   press (Brand Guide). These two shipped with no hover state at all. */
.fd406-actionbar__demo:hover{background:var(--accent-hover,#EEB659)}
.fd406-actionbar__demo:active{background:var(--accent-press,#D08F22)}
.fd406-actionbar__call{
  flex:none;display:inline-flex;align-items:center;justify-content:center;
  width:46px;height:44px;border-radius:8px;text-decoration:none;
  border:1.5px solid rgba(255,255,255,.35);color:#fff;
  transition:border-color .2s ease,color .2s ease;
}
/* Outline sibling follows the outline convention: border + label go amber. */
.fd406-actionbar__call:hover{border-color:var(--accent,#E8A435);color:var(--accent,#E8A435)}
@media (max-width:760px){
  .fd406-actionbar{display:flex}
  /* One floating call action, not two. */
  body.fd406-past-hero .call-cta{opacity:0;pointer-events:none;transition:opacity .2s ease}
}
@media (prefers-reduced-motion:reduce){.fd406-actionbar{transition:none}}
</style>

{# Mobile-only persistent CTA. Hidden until you scroll past the page's own
   above-fold CTA — same trigger as the nav CTA, one observer for both. #}
<div class="fd406-actionbar">
  <a class="fd406-actionbar__demo" href="/demo/">Try the Live Demo</a>
  <a class="fd406-actionbar__call" href="tel:{{ site.phone }}" aria-label="Call {{ site.phoneDisplay }}">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
  </a>
</div>

<script>
/* Sets ONE body class, fd406-past-hero, when the top of the page has scrolled
   away. Only the mobile action bar consumes it — the desktop nav CTA is always
   visible (see header.njk).

   The watched element is the page's own above-fold CTA where one exists, so the
   bar arrives exactly as that CTA leaves. Pages WITHOUT such a CTA still need
   the bar — below 760px they have no nav CTA either, so they would otherwise
   have no persistent CTA at all — hence the fallback to the first section.
   Feature-detected: with no IntersectionObserver the class is never set and the
   bar simply stays offscreen, which is the safe state. */
(function () {
  var main = document.getElementById('main');
  if (!main || !('IntersectionObserver' in window)) return;
  var hero = main.querySelector('a.btn-primary, a.btn-white, .cta-actions a, .hero-cta a');
  // A CTA three screens down is not a hero CTA; fall back to the first section.
  if (!hero || hero.getBoundingClientRect().top > window.innerHeight * 1.5) {
    hero = main.querySelector('section, .header-band, .page-header');
  }
  if (!hero) return;
  new IntersectionObserver(function (entries) {
    document.body.classList.toggle('fd406-past-hero', !entries[0].isIntersecting);
  }, { rootMargin: '-8px 0px 0px 0px' }).observe(hero);
})();
</script>
</body>
</html>
