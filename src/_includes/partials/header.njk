{# ============================================================
   406 FRONT DESK — REUSABLE HEADER / NAV
   Single source of truth. Links come from _data/site.json.
   ============================================================ #}
<style>
  .fd406-nav, .fd406-nav *, .fd406-mobile-menu, .fd406-mobile-menu * { box-sizing: border-box; }
  /* Navy masthead. SOLID #0F2540 on purpose, not the old translucent wash:
     it must match the footer and the legal pages' .header-band exactly, and any
     alpha would let the cream page bleed through and break that seam as you
     scroll. The hairline is white-on-navy so it still reads over a cream page
     without drawing a line across the merged masthead on /privacy-policy/,
     /terms-conditions/ and /sms-consent/. */
  .fd406-nav {
    position: sticky; top: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 40px;
    background: #0F2540;
    border-bottom: 1px solid rgba(255,255,255,0.10);
    font-family: 'DM Sans', system-ui, sans-serif;
  }
  .fd406-nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
  /* Identity v2 mark is a circular badge (1:1), not the old 1.52:1 state shape. */
  .fd406-nav-logo-mark { height: 30px; width: 30px; display: flex; align-items: center; }
  .fd406-nav-logo-mark img { height: 30px; width: 30px; display: block; }
  .fd406-nav-logo-text { font-size: 16px; font-weight: 600; color: #FFFFFF; letter-spacing: -0.3px; }
  .fd406-nav-logo-sub {
    /* #B9C2D0 is the Brand Guide's muted-on-navy token. The old #696D76 was a
       cream-ground value and lands at 2.98:1 here — it must not come back. */
    font-size: 11px; font-weight: 400; color: #B9C2D0; letter-spacing: 0.8px;
    text-transform: uppercase; display: block; line-height: 1; margin-top: 1px;
  }
  .fd406-nav-right { display: flex; align-items: center; gap: 28px; }
  .fd406-nav-links { display: flex; align-items: center; gap: 26px; }
  .fd406-nav-links a {
    text-decoration: none; color: #DCE3EC; font-size: 14px; font-weight: 500; transition: color 0.2s;
  }
  .fd406-nav-links a:hover { color: #E8A435; }
  /* Amber is now the CTA's REST state. It used to be the hover, which left the
     page's primary action styled as secondary until you touched it. Hover/press
     come from the Brand Guide's amber ramp; the label stays navy per the
     amber-ground convention used by .call-cta and .btn-primary. */
  .fd406-nav-cta {
    background: #E8A435; color: #0F2540; padding: 10px 22px; border-radius: 8px;
    text-decoration: none; font-size: 14px; font-weight: 600; transition: background 0.2s, color 0.2s;
  }
  .fd406-nav-cta:hover { background: #EEB659; color: #0F2540; }
  .fd406-nav-cta:active { background: #D08F22; color: #0F2540; }
  /* The nav CTA is ALWAYS visible on desktop. It was briefly scroll-revealed to
     avoid twinning with a page's own hero CTA, but that was solving the wrong
     problem: the real defect was that the two buttons shared a label and a
     colour while going to DIFFERENT places (/demo/ vs the since-deleted #demo
     section). Unifying the destination fixed it. Hiding the button only left a
     233px hole in the bar, because opacity keeps the box in the layout.
     base.njk still sets fd406-past-hero — the MOBILE action bar needs it. */

  .fd406-nav-toggle {
    display: none; background: none; border: none; cursor: pointer;
    width: 40px; height: 40px; padding: 8px;
    flex-direction: column; justify-content: center; gap: 5px;
  }
  .fd406-nav-toggle span {
    /* Was #1B2A4A — invisible against the navy masthead. */
    display: block; height: 2px; width: 100%;
    background: #DCE3EC; border-radius: 2px; transition: transform 0.3s, opacity 0.3s;
  }
  .fd406-nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .fd406-nav-toggle.open span:nth-child(2) { opacity: 0; }
  .fd406-nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .fd406-mobile-overlay {
    position: fixed; inset: 0; background: rgba(10,16,30,0.5);
    z-index: 1050; opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .fd406-mobile-overlay.open { opacity: 1; pointer-events: auto; }
  .fd406-mobile-menu {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: min(78vw, 320px); background: #1B2A4A; z-index: 1100;
    transform: translateX(100%); transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), visibility 0.32s;
    display: flex; flex-direction: column; padding: 90px 32px 32px;
    box-shadow: -20px 0 60px rgba(0,0,0,0.3);
    font-family: 'DM Sans', system-ui, sans-serif;
    /* Closed, the panel is only moved off-screen by transform — its six links stay
       focusable at every viewport, so keyboard users tab through invisible stops.
       visibility:hidden takes them out of the tab order and the accessibility tree;
       transitioning it keeps the slide-out animation intact. */
    visibility: hidden;
  }
  .fd406-mobile-menu.open { transform: translateX(0); visibility: visible; }
  .fd406-mobile-menu a {
    color: rgba(255,255,255,0.85); text-decoration: none; font-size: 18px; font-weight: 500;
    padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1); transition: color 0.2s;
  }
  .fd406-mobile-menu a:hover { color: #E8A435; }
  .fd406-mobile-menu .fd406-mm-cta {
    margin-top: 24px; background: #E8A435; color: #1B2A4A; text-align: center;
    border-radius: 12px; font-weight: 600; padding: 15px; border-bottom: none;
  }
  .fd406-mobile-menu .fd406-mm-cta:hover { background: #fff; color: #1B2A4A; }
  body.fd406-menu-open { overflow: hidden; }

  @media (max-width: 900px) { .fd406-nav { padding: 14px 24px; } }
  @media (max-width: 760px) {
    .fd406-nav-links { display: none; }
    .fd406-nav-toggle { display: flex; }
    .fd406-nav-right .fd406-nav-cta { display: none; }
  }
</style>

<nav class="fd406-nav">
  <a class="fd406-nav-logo" href="/">
    {# Identity v2 (2026-08-30): the MICRO mark — the measured Many Glacier
       ridgeline, no numerals. At a 30px render the badge cannot carry three
       serif digits, so the "406" moves into the wordmark beside it instead.
       That is why the text reads "406 Front Desk" here and not "Front Desk".
       Source of truth: raw/assets/406-front-desk/branding-v2/ (rebuild with
       assets.py — never hand-edit the PNG). #}
    <div class="fd406-nav-logo-mark"><img src="/assets/img/nav-mark-v2.png" width="30" height="30" alt="406 Front Desk"></div>
    <div>
      <span class="fd406-nav-logo-text">406 Front Desk</span>
      <span class="fd406-nav-logo-sub">Always Answering</span>
    </div>
  </a>
  <div class="fd406-nav-right">
    <div class="fd406-nav-links">
      {%- for item in site.nav %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </div>
    <a class="fd406-nav-cta" href="/demo/">Try the Live Demo</a>
    <button class="fd406-nav-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</nav>

<div class="fd406-mobile-overlay"></div>
<div class="fd406-mobile-menu">
  {%- for item in site.nav %}
  <a href="{{ item.url }}">{{ item.label }}</a>
  {%- endfor %}
  <a class="fd406-mm-cta" href="/demo/">Try the Live Demo</a>
</div>

<script>
  (function () {
    var toggle = document.querySelector('.fd406-nav-toggle');
    var menu = document.querySelector('.fd406-mobile-menu');
    var overlay = document.querySelector('.fd406-mobile-overlay');
    if (!toggle || !menu) return;
    function close() {
      toggle.classList.remove('open'); menu.classList.remove('open');
      if (overlay) overlay.classList.remove('open');
      document.body.classList.remove('fd406-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
    toggle.addEventListener('click', function () {
      var isOpen = menu.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      if (overlay) overlay.classList.toggle('open', isOpen);
      document.body.classList.toggle('fd406-menu-open', isOpen);
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      // Move focus into the panel on open so keyboard users land where the menu is.
      if (isOpen) { var first = menu.querySelector('a'); if (first) first.focus(); }
    });
    if (overlay) overlay.addEventListener('click', close);
    // Escape closes the panel and hands focus back to the button that opened it.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('open')) { close(); toggle.focus(); }
    });
    menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
  })();
</script>
