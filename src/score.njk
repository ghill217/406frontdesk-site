scoreFormId: "IRwcugzKQESclKqcXgNI"
---
{% from "partials/icons.njk" import icon %}

<!-- ── HERO ── -->
<div class="header-band">
  <span class="header-eyebrow">Two minutes · No email required</span>
  <h1>How good is your <em>front desk?</em></h1>
  <p>Ten questions about what actually happens when someone tries to reach your business. You get the
    grade on screen the moment you finish — no form in the way, nothing to unlock.</p>
</div>

<div class="wrap">
  <!-- The quiz renders all ten questions in the markup so the page works without
       JavaScript and so search engines see real content. JS then enhances it into
       a one-question-at-a-time stepper. -->
  <form class="quiz" id="quiz" novalidate>
    <div class="quiz-progress" id="progress" hidden>
      <div class="progress-meta">
        <span id="progressLabel">Question 1 of 10</span>
        <span id="progressPct">0%</span>
      </div>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
    </div>

    <fieldset class="q" data-leak="After-hours calls go unanswered. That is every evening, every weekend, and every holiday when someone who wanted to give you money reached a beep instead.">
      <legend><span class="q-num">01</span> It's 7:40pm on a Thursday. Someone finds you on Google and calls.</legend>
      <label class="opt"><input type="radio" name="q1" value="10"><span>A person picks up</span></label>
      <label class="opt"><input type="radio" name="q1" value="4"><span>Voicemail, and I call back the next morning</span></label>
      <label class="opt"><input type="radio" name="q1" value="1"><span>Voicemail, and honestly I don't always get to it</span></label>
      <label class="opt"><input type="radio" name="q1" value="0"><span>It just rings</span></label>
    </fieldset>

    <fieldset class="q" data-leak="The phone goes unanswered exactly when you're busiest — and being busy is when the next customer is most likely to call.">
      <legend><span class="q-num">02</span> You're mid-job or mid-appointment and the phone rings.</legend>
      <label class="opt"><input type="radio" name="q2" value="10"><span>Someone else always picks it up</span></label>
      <label class="opt"><input type="radio" name="q2" value="5"><span>I stop and answer it if I can</span></label>
      <label class="opt"><input type="radio" name="q2" value="2"><span>It goes to voicemail</span></label>
      <label class="opt"><input type="radio" name="q2" value="0"><span>I don't even hear it</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Your response time is long enough for someone to call the next shop on the list and book there before you ring back.">
      <legend><span class="q-num">03</span> Someone leaves a message or fills out your form. How long until they hear back?</legend>
      <label class="opt"><input type="radio" name="q3" value="10"><span>Within about five minutes</span></label>
      <label class="opt"><input type="radio" name="q3" value="6"><span>Same day</span></label>
      <label class="opt"><input type="radio" name="q3" value="3"><span>Next business day</span></label>
      <label class="opt"><input type="radio" name="q3" value="0"><span>Longer, or it depends how busy we are</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Customers who would rather text than call can't — and a lot of people will simply not call at all.">
      <legend><span class="q-num">04</span> Can a customer text your business number?</legend>
      <label class="opt"><input type="radio" name="q4" value="10"><span>Yes, and we answer quickly</span></label>
      <label class="opt"><input type="radio" name="q4" value="5"><span>Yes, but it's my personal phone</span></label>
      <label class="opt"><input type="radio" name="q4" value="1"><span>No, it's a landline</span></label>
      <label class="opt"><input type="radio" name="q4" value="0"><span>I'm not sure</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Every booking has to pass through a human conversation, which caps how many you can take and loses everyone who won't make the call.">
      <legend><span class="q-num">05</span> Can a new customer book without talking to a person?</legend>
      <label class="opt"><input type="radio" name="q5" value="10"><span>Yes, online, any time of day</span></label>
      <label class="opt"><input type="radio" name="q5" value="6"><span>Yes, but only through a third-party app</span></label>
      <label class="opt"><input type="radio" name="q5" value="2"><span>No, they have to call us</span></label>
      <label class="opt"><input type="radio" name="q5" value="0"><span>No, and it usually turns into phone tag</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Messages that arrive on Google or Facebook sit unread through the weekend — the exact stretch when people are searching and comparing.">
      <legend><span class="q-num">06</span> It's Saturday and you're closed. Someone messages you on Google or Facebook.</legend>
      <label class="opt"><input type="radio" name="q6" value="10"><span>They get an answer</span></label>
      <label class="opt"><input type="radio" name="q6" value="4"><span>They hear back Monday</span></label>
      <label class="opt"><input type="radio" name="q6" value="1"><span>Eventually, when someone remembers</span></label>
      <label class="opt"><input type="radio" name="q6" value="0"><span>Nobody really checks those</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Missed calls with no message are invisible losses — nobody ever tells you about the customer who dialled once and gave up.">
      <legend><span class="q-num">07</span> Someone calls, doesn't leave a message, and hangs up.</legend>
      <label class="opt"><input type="radio" name="q7" value="10"><span>They automatically get a text back</span></label>
      <label class="opt"><input type="radio" name="q7" value="5"><span>We call back when we notice it</span></label>
      <label class="opt"><input type="radio" name="q7" value="0"><span>Nothing happens</span></label>
    </fieldset>

    <fieldset class="q" data-leak="No automatic reminders means no-shows you absorb yourself — an empty chair you already paid for.">
      <legend><span class="q-num">08</span> Do booked appointments get automatic reminders?</legend>
      <label class="opt"><input type="radio" name="q8" value="10"><span>Yes, by text or email, every time</span></label>
      <label class="opt"><input type="radio" name="q8" value="5"><span>Sometimes, if we remember to send them</span></label>
      <label class="opt"><input type="radio" name="q8" value="0"><span>No</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Happy customers leave without being asked for a review, so your Google rating grows far slower than your actual reputation.">
      <legend><span class="q-num">09</span> After a job goes well, does anything ask that customer for a review?</legend>
      <label class="opt"><input type="radio" name="q9" value="10"><span>Yes, automatically</span></label>
      <label class="opt"><input type="radio" name="q9" value="5"><span>I ask in person when I think of it</span></label>
      <label class="opt"><input type="radio" name="q9" value="0"><span>No</span></label>
    </fieldset>

    <fieldset class="q" data-leak="Conversations are scattered across separate apps and inboxes, which is how a real customer falls through a crack nobody is watching.">
      <legend><span class="q-num">10</span> Calls, texts, web forms, Facebook and Google messages — where do they land?</legend>
      <label class="opt"><input type="radio" name="q10" value="10"><span>All in one inbox</span></label>
      <label class="opt"><input type="radio" name="q10" value="5"><span>Two or three different places</span></label>
      <label class="opt"><input type="radio" name="q10" value="0"><span>All over the place — I just try to keep up</span></label>
    </fieldset>

    <div class="quiz-nav" id="quizNav" hidden>
      <button type="button" class="btn-back" id="btnBack">Back</button>
      <button type="button" class="btn-primary" id="btnNext" disabled>Next</button>
    </div>

    <div class="quiz-submit" id="quizSubmit">
      <button type="button" class="btn-primary" id="btnScore">Show my score</button>
      <p class="quiz-submit-note">Answer all ten first. Nothing is sent anywhere — the grading happens on your own device.</p>
    </div>
  </form>

  <!-- ── RESULT ── -->
  <section class="result-card" id="result" hidden tabindex="-1" aria-live="polite">
    <div class="result-head">
      <div class="result-label">Your Front Desk Score</div>
      <div class="result-score"><span id="scoreNum">0</span><span class="result-outof">/100</span></div>
      <div class="result-grade" id="scoreGrade">F</div>
      <div class="result-tier" id="scoreTier"></div>
      <p class="result-verdict" id="scoreVerdict"></p>
    </div>

    <div class="result-body">
      {# h2, not h3: this is the first heading after the page h1, and the a11y
         audit (npm run audit) fails the build on an h1->h3 jump. #}
      <h2 class="leak-title" id="leakTitle">Your biggest leaks</h2>
      <ol class="leak-list" id="leakList"></ol>
      <p class="result-honesty">Graded from your own ten answers, nothing else. We didn't measure your
        business — you did. That's why it's worth what you put into it.</p>
    </div>

    <div class="result-cta">
      <div class="result-cta-content">
        <div class="section-label">What Now</div>
        <h3>Want the other half of the picture?</h3>
        <p>This graded how your <strong>phone</strong> is covered. The other place customers quietly
          disappear is your <strong>website</strong> — and we'll grade that one by hand, twelve checks
          with the receipts, and send it back inside a day. Free, same as this was.</p>

        {% if scoreFormId %}
        <!-- Never add loading="lazy" — form_embed.js can't hook it and the iframe collapses. -->
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/{{ scoreFormId }}"
          style="width:100%;min-height:460px;border:none;border-radius:8px"
          id="inline-{{ scoreFormId }}"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-activation-type="alwaysActivated"
          data-deactivation-type="neverDeactivate"
          data-form-name="Front Desk Score — Result"
          data-height="460"
          data-layout-iframe-id="inline-{{ scoreFormId }}"
          data-form-id="{{ scoreFormId }}"
          title="Free website scorecard request form"
        ></iframe>
        <script src="https://link.msgsndr.com/js/form_embed.js"></script>
        {% else %}
        {# FALLBACK — public-safe by design. This page is indexed, so the block
           must read as a normal CTA until scoreFormId is set, never as developer
           instructions. Hands off to /scorecard/, which carries the same form. #}
        <div class="form-fallback">
          <p>Takes about thirty seconds, and the scorecard comes back within a day.</p>
          <a href="/scorecard/" class="btn-primary">Get my free website scorecard</a>
          <span class="form-fallback-note">Free, no card, no obligation.</span>
        </div>
        {% endif %}

        <p class="result-alt">Rather just talk it through? <a href="/start/">Book twenty minutes</a> —
          the agenda is published, and our <a href="/pricing/">pricing is public</a> before you ever
          get on the call. Or work out what the misses are costing you on the
          <a href="/roi/">missed-call calculator</a>.</p>
      </div>
    </div>

    <button type="button" class="btn-retake" id="btnRetake">Start over</button>
  </section>

  <noscript>
    <div class="form-staging" style="margin-top:24px">
      <strong>This quiz needs JavaScript to add up your score.</strong>
      <span>The ten questions above are still worth reading — they're the ten places a front desk
        usually leaks. To get the same answer from a person instead, book twenty minutes.</span>
      <a href="/start/" class="btn-primary">Start here</a>
    </div>
  </noscript>
</div>

<!-- ── WHY THESE TEN ── -->
<section class="context">
  <div class="section-inner">
    <div class="section-head fade-in">
      <div class="section-label">Why These Ten</div>
      <h2 class="section-title">Every one of them is a place we've watched money leave.</h2>
      <p class="section-sub">These aren't personality questions and there's no flattering result hiding
        at the end. They're the ten failure points we see over and over in Flathead Valley shops — the
        ones owners are genuinely surprised by, because a missed customer never calls to complain.</p>
    </div>
    <div class="ctx-grid fade-in">
      <div class="ctx-cell"><h3>The clock</h3><p>Evenings, weekends, holidays. Most of the week your business is closed, and people search anyway.</p></div>
      <div class="ctx-cell"><h3>The channel</h3><p>Phone, text, web form, Google, Facebook. Customers pick one at random and expect the same answer.</p></div>
      <div class="ctx-cell"><h3>The follow-through</h3><p>Reminders, callbacks, review asks. The work that only happens when something remembers to do it.</p></div>
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById("quiz");
    if (!form) return;

    var qs = Array.prototype.slice.call(form.querySelectorAll(".q"));
    var total = qs.length;
    var idx = 0;

    var progress = document.getElementById("progress");
    var progressLabel = document.getElementById("progressLabel");
    var progressPct = document.getElementById("progressPct");
    var progressFill = document.getElementById("progressFill");
    var nav = document.getElementById("quizNav");
    var btnBack = document.getElementById("btnBack");
    var btnNext = document.getElementById("btnNext");
    var submitBlock = document.getElementById("quizSubmit");
    var result = document.getElementById("result");

    // Enhance: hide the all-at-once view, switch on the stepper.
    progress.hidden = false;
    nav.hidden = false;
    submitBlock.hidden = true;
    form.classList.add("stepped");

    function answered(i) {
      return !!qs[i].querySelector("input:checked");
    }

    function show(i) {
      qs.forEach(function (q, n) { q.classList.toggle("active", n === i); });
      idx = i;
      progressLabel.textContent = "Question " + (i + 1) + " of " + total;
      var pct = Math.round((i / total) * 100);
      progressPct.textContent = pct + "%";
      progressFill.style.width = pct + "%";
      btnBack.disabled = i === 0;
      btnNext.disabled = !answered(i);
      btnNext.textContent = i === total - 1 ? "Show my score" : "Next";
      var legend = qs[i].querySelector("legend");
      if (legend) legend.setAttribute("tabindex", "-1");
    }

    form.addEventListener("change", function (e) {
      if (e.target && e.target.type === "radio") {
        btnNext.disabled = false;
        // Give the tap a beat to register visually, then advance.
        window.setTimeout(function () {
          if (idx < total - 1 && answered(idx)) { show(idx + 1); }
          else if (idx === total - 1) { btnNext.focus(); }
        }, 220);
      }
    });

    btnNext.addEventListener("click", function () {
      if (!answered(idx)) return;
      if (idx < total - 1) { show(idx + 1); } else { grade(); }
    });
    btnBack.addEventListener("click", function () { if (idx > 0) show(idx - 1); });

    function tierFor(score) {
      if (score >= 85) return {
        grade: "A", label: "Tight.",
        verdict: "Your front desk is genuinely well covered. The gaps left are small ones, and you're already doing the things most shops your size never get to. Worth protecting rather than rebuilding."
      };
      if (score >= 70) return {
        grade: "B", label: "Solid, with a leak.",
        verdict: "Most of your bases are covered, which makes the ones that aren't more expensive than they look — a good front desk with one open channel still loses the people who pick that channel."
      };
      if (score >= 55) return {
        grade: "C", label: "Covered while you're there.",
        verdict: "When you're at the shop and free, nobody slips past you. The problem is how much of the week that isn't — evenings, weekends, and every stretch you're busy with a customer."
      };
      if (score >= 40) return {
        grade: "D", label: "The phone is running you.",
        verdict: "Right now the phone sets your day rather than the other way around, and enough is falling through that you're losing customers you never find out about. Most of this is fixable without hiring anyone."
      };
      return {
        grade: "F", label: "People are getting through to nobody.",
        verdict: "As it stands, a stranger who wants to give you money has a real chance of reaching nothing at all. That's not a knock on how you work — it's the most common setup there is, and it's the cheapest thing on this list to fix."
      };
    }

    function grade() {
      var score = 0;
      var leaks = [];
      qs.forEach(function (q) {
        var checked = q.querySelector("input:checked");
        var pts = checked ? parseInt(checked.value, 10) : 0;
        score += pts;
        if (pts < 10) { leaks.push({ lost: 10 - pts, text: q.getAttribute("data-leak") }); }
      });

      leaks.sort(function (a, b) { return b.lost - a.lost; });
      var top = leaks.slice(0, 3);

      var t = tierFor(score);
      document.getElementById("scoreNum").textContent = score;
      document.getElementById("scoreGrade").textContent = t.grade;
      document.getElementById("scoreGrade").setAttribute("data-grade", t.grade);
      document.getElementById("scoreTier").textContent = t.label;
      document.getElementById("scoreVerdict").textContent = t.verdict;

      var list = document.getElementById("leakList");
      list.innerHTML = "";
      var title = document.getElementById("leakTitle");
      if (!top.length) {
        title.textContent = "No leaks found";
        var li = document.createElement("li");
        li.textContent = "You answered every question with the strongest option. That's rare — there's nothing here we'd tell you to change.";
        list.appendChild(li);
      } else {
        title.textContent = top.length === 1 ? "Your one leak" : "Your " + (top.length === 2 ? "two" : "three") + " biggest leaks";
        top.forEach(function (l) {
          var li = document.createElement("li");
          li.textContent = l.text;
          list.appendChild(li);
        });
      }

      form.hidden = true;
      result.hidden = false;
      result.focus();
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    document.getElementById("btnRetake").addEventListener("click", function () {
      form.reset();
      result.hidden = true;
      form.hidden = false;
      show(0);
      form.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    show(0);
  })();

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add("visible"); });
  }, { threshold: 0.1 });
  document.querySelectorAll(".fade-in").forEach(function (el) { observer.observe(el); });
</script>
